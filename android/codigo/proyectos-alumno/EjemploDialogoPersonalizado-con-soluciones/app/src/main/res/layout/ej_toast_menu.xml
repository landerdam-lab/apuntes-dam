<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <Button
        android:id="@+id/btnToast2s"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Toast (se cierra a los 2 s)" />

    <Button
        android:id="@+id/btnToastTocar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Toast (se cierra al tocarlo)" />

    <Button
        android:id="@+id/btnCarga3s"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Animacion de carga (3 s) y nueva pantalla" />

</LinearLayout>
